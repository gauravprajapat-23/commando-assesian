[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/mission_hud.gd" id="1_hud"]

[node name="MissionHUD" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_hud")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
offset_left = 16.0
offset_top = 16.0
offset_right = 450.0
offset_bottom = 128.0
mouse_filter = 2

[node name="Status" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ObjectiveLabel" type="Label" parent="Panel/Status"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "OBJECTIVE: Mission not started"
autowrap_mode = 3

[node name="HealthLabel" type="Label" parent="Panel/Status"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "HEALTH: --"

[node name="AmmoLabel" type="Label" parent="Panel/Status"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "AMMO: --"
